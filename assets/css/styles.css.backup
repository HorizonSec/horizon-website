/* Reset and Base Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Color Palette */
    --primary-bg: #0a0a0a;
    --secondary-bg: #1a1a1a;
    --tertiary-bg: #2a2a2a;
    --accent-blue: #00d4ff;
    --accent-cyan: #00ffff;
    --accent-green: #00ff88;
    --text-primary: #ffffff;
    --text-secondary: #cccccc;
    --text-muted: #888888;
    --border-color: #333333;
    --code-bg: #1e1e1e;
    --warning-color: #ff9f00;
    --error-color: #ff4444;
    --success-color: #00cc66;
    
    /* Typography */
    --font-primary: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', 'Fira Code', 'Monaco', monospace;
    
    /* Spacing */
    --section-padding: 5rem 0;
    --container-padding: 0 2rem;
    
    /* Shadows */
    --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 8px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 8px 16px rgba(0, 0, 0, 0.5);
    --glow-blue: 0 0 20px rgba(0, 212, 255, 0.3);
    --glow-cyan: 0 0 20px rgba(0, 255, 255, 0.3);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: var(--font-primary);
    line-height: 1.6;
    color: var(--text-primary);
    background: var(--primary-bg);
    overflow-x: hidden;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--container-padding);
}

/* Typography */
h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 1rem;
}

h1 {
    font-size: 3.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

h2 {
    font-size: 2.5rem;
    color: var(--text-primary);
    text-align: center;
}

h3 {
    font-size: 1.8rem;
    color: var(--text-primary);
}

h4 {
    font-size: 1.4rem;
    color: var(--text-secondary);
}

p {
    margin-bottom: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
}

.section-intro {
    font-size: 1.3rem;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--text-secondary);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
}

/* Header and Navigation */
header {
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-md);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    border-bottom: 1px solid var(--border-color);
}

.navbar {
    padding: 1rem 0;
    position: sticky;
    top: 0;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    z-index: 1000;
}

.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 60px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.logo a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: all 0.3s ease;
}

.logo img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent-blue);
    box-shadow: var(--glow-blue);
    transition: all 0.3s ease;
}

.logo img:hover {
    transform: scale(1.05);
    box-shadow: 0 0 25px rgba(0, 212, 255, 0.5);
}

.logo-text {
    font-size: 1.4rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    white-space: nowrap;
}

.logo h1 {
    font-size: 1.8rem;
    font-weight: 700;
    margin: 0;
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.logo .subtitle {
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
}

.nav-menu {
    display: flex;
    list-style: none;
    gap: 2rem;
    align-items: center;
}

.nav-menu a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    position: relative;
}

.nav-menu a:hover,
.nav-menu a.active {
    color: var(--accent-blue);
}

.nav-menu a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-blue), var(--accent-cyan));
    transform: scaleX(0);
    transition: transform 0.3s ease;
}

.nav-menu a:hover::after,
.nav-menu a.active::after {
    transform: scaleX(1);
}

.nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--text-primary);
    font-size: 1.5rem;
    cursor: pointer;
}

/* Hero Section */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: var(--primary-bg);
    position: relative;
    overflow: hidden;
    padding: 8rem 0 5rem;
}

.hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
        radial-gradient(circle at 20% 80%, rgba(0, 212, 255, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(0, 255, 255, 0.1) 0%, transparent 50%);
    z-index: 1;
}

/* Page Hero Section (for non-home pages) */
.page-hero {
    background: linear-gradient(135deg, rgba(0, 30, 60, 0.6) 0%, rgba(0, 15, 30, 0.8) 100%);
    padding: 140px 0 80px; /* Extra top padding to account for sticky navbar */
    text-align: center;
    margin-top: 0;
    position: relative;
}

.page-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
        radial-gradient(circle at 30% 70%, rgba(0, 212, 255, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 70% 30%, rgba(0, 255, 255, 0.08) 0%, transparent 50%);
    z-index: 1;
}

.page-hero .container {
    position: relative;
    z-index: 2;
}

.page-hero h1 {
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 20px;
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.page-hero .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
}

.hero .container {
    position: relative;
    z-index: 2;
}

.hero-content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
}

.hero-content h1 {
    font-size: 4rem;
    margin-bottom: 0.5rem;
    text-shadow: var(--glow-blue);
}

.hero-subtitle {
    font-size: 1.5rem;
    color: var(--accent-cyan);
    font-weight: 400;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.hero-description {
    font-size: 1.3rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    line-height: 1.8;
}

.hero-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-bottom: 3rem;
    flex-wrap: wrap;
}

.hero-features {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.feature-badge {
    background: rgba(0, 212, 255, 0.1);
    border: 1px solid rgba(0, 212, 255, 0.3);
    color: var(--accent-blue);
    padding: 0.5rem 1rem;
    border-radius: 25px;
    font-size: 0.9rem;
    font-weight: 500;
    backdrop-filter: blur(10px);
}

/* Buttons */
.btn {
    display: inline-block;
    padding: 1rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    position: relative;
    overflow: hidden;
    text-align: center;
}

.btn-primary {
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-cyan) 100%);
    color: var(--primary-bg);
    box-shadow: var(--glow-blue);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--glow-blue), var(--shadow-lg);
}

.btn-secondary {
    background: transparent;
    color: var(--accent-blue);
    border: 2px solid var(--accent-blue);
}

.btn-secondary:hover {
    background: var(--accent-blue);
    color: var(--primary-bg);
    transform: translateY(-2px);
    box-shadow: var(--glow-blue);
}

/* Section Styles */
section {
    padding: var(--section-padding);
}

section:nth-child(even) {
    background: var(--secondary-bg);
}

/* Problem Section */
.problem {
    padding: 80px 0;
    background: var(--dark-bg);
}

.problem-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.problem-text .lead {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--accent-color);
    margin-bottom: 20px;
}

.pain-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.pain-point {
    background: var(--card-bg);
    padding: 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    text-align: center;
}

.pain-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 10px;
}

.pain-point h4 {
    color: var(--accent-color);
    margin: 10px 0 5px 0;
}

.pain-point p {
    font-size: 0.9rem;
    opacity: 0.8;
}

/* Solution Section */
.solution {
    padding: 80px 0;
}

.solution-principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    margin-top: 50px;
}

.principle {
    text-align: center;
    padding: 30px;
}

.principle-icon {
    font-size: 3rem;
    margin-bottom: 20px;
    display: block;
}

.principle h3 {
    color: var(--accent-color);
    margin-bottom: 15px;
}

/* Framework Overview Section */
.framework-overview {
    padding: 80px 0;
    background: var(--dark-bg);
}

.framework-cta {
    text-align: center;
    margin-top: 60px;
    padding: 40px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
}

.framework-cta h3 {
    color: var(--accent-color);
    margin-bottom: 15px;
}

.cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin-top: 25px;
}

/* Mission & Vision Section */
.mission-vision {
    padding: 80px 0;
}

.mission-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 60px;
    align-items: center;
}

.mission-text .lead {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--accent-color);
    margin-bottom: 20px;
}

.mission-stats {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.stat-item {
    text-align: center;
    padding: 20px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
}

.stat-item h3 {
    font-size: 2rem;
    color: var(--accent-color);
    margin-bottom: 5px;
}

/* Founders Section */
.founders {
    padding: 80px 0;
    background: var(--dark-bg);
}

.founders-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 50px;
}

.founder-card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 30px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.founder-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 255, 255, 0.1);
}

.founder-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-cyan));
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar-initial {
    font-size: 2rem;
    font-weight: 700;
    color: white;
}

.founder-info h3 {
    font-size: 1.5rem;
    color: var(--accent-color);
    margin-bottom: 5px;
}

.founder-title {
    color: var(--accent-blue);
    font-weight: 500;
    margin-bottom: 15px;
    font-size: 0.95rem;
}

.founder-bio {
    line-height: 1.6;
    margin-bottom: 20px;
    opacity: 0.9;
}

.founder-expertise {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
}

.expertise-tag {
    background: rgba(0, 188, 255, 0.1);
    color: var(--accent-cyan);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    border: 1px solid rgba(0, 188, 255, 0.2);
}

.team-mission {
    text-align: center;
    margin-top: 60px;
    padding: 40px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
}

.team-mission h3 {
    color: var(--accent-color);
    margin-bottom: 20px;
    font-size: 1.4rem;
}

.team-mission p {
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
    opacity: 0.95;
}

/* Community Preview Section */
.community-preview {
    padding: 80px 0;
    background: var(--dark-bg);
    text-align: center;
}

.community-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin: 50px 0;
}

.stat {
    padding: 30px;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    text-align: center;
}

.stat-number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent-color);
    display: block;
    margin-bottom: 10px;
}

.stat-label {
    font-size: 0.9rem;
    opacity: 0.8;
}

.community-cta {
    margin-top: 40px;
    text-align: center;
    padding: 80px 0;
    background: linear-gradient(135deg, var(--primary-bg) 0%, var(--secondary-bg) 100%);
}

.community-cta h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
    text-align: center;
}

.community-cta p {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.community-cta .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
}

.community-cta h3 {
    color: var(--accent-color);
    margin-bottom: 15px;
}

/* Final CTA Section */
.final-cta {
    padding: 100px 0;
    text-align: center;
}

.cta-subtitle {
    font-size: 1.5rem;
    color: var(--accent-color);
    margin-bottom: 50px;
    font-style: italic;
}

.cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    margin-top: 50px;
}

.cta-item {
    background: var(--card-bg);
    padding: 40px 30px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.cta-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 255, 255, 0.1);
}

.cta-item h3 {
    color: var(--accent-color);
    margin-bottom: 15px;
}

.cta-item p {
    margin-bottom: 25px;
    opacity: 0.9;
}

/* Mission Section */
.mission {
    text-align: center;
}

.mission blockquote {
    font-size: 1.5rem;
    font-style: italic;
    color: var(--accent-cyan);
    border-left: 4px solid var(--accent-blue);
    padding: 2rem;
    margin: 2rem auto;
    max-width: 800px;
    background: rgba(0, 212, 255, 0.05);
    border-radius: 8px;
}

.mission-principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
}

.principle {
    text-align: center;
    padding: 1.5rem;
}

.principle h4 {
    color: var(--accent-blue);
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
}

/* Framework Section */
.framework {
    background: var(--secondary-bg);
}

.modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
}

.module-card {
    background: var(--tertiary-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
}

.module-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-blue);
    box-shadow: var(--glow-blue);
}

.module-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
}

.module-icon {
    font-size: 2rem;
}

.module-header h3 {
    flex: 1;
    margin: 0;
    color: var(--text-primary);
    font-size: 1.3rem;
}

.status {
    padding: 0.3rem 0.8rem;
    border-radius: 15px;
    font-size: 0.8rem;
    font-weight: 500;
}

.status.in-development {
    background: rgba(255, 159, 0, 0.2);
    color: rgba(255, 159, 0, 1);
    border: 1px solid rgba(255, 159, 0, 1);
}

.status.planning {
    background: rgb(4, 0, 255);
    color: white;
    border: 1px solid white;
}

.status.complete {
    background: rgba(0, 204, 102, 0.2);
    color: rgba(0, 204, 102, 1);
    border: 1px solid rgba(0, 204, 102, 1);
}

.module-features {
    list-style: none;
    margin-top: 1rem;
}

.module-features li {
    color: var(--text-secondary);
    padding: 0.3rem 0;
    padding-left: 1rem;
    position: relative;
}

.module-features li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-blue);
}

/* About Section */
.about-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: center;
}

.about-text p {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
}

.about-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
}

.stat-item {
    text-align: center;
    padding: 1.5rem;
    background: var(--tertiary-bg);
    border-radius: 8px;
    border: 1px solid var(--border-color);
}

.stat-item h3 {
    font-size: 2rem;
    color: var(--accent-blue);
    margin-bottom: 0.5rem;
}

.stat-item p {
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* Features Section */
.features {
    background: var(--secondary-bg);
}

.feature-categories {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
}

.feature-category h3 {
    color: var(--accent-blue);
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
}

.integration-category h3 {
    color: var(--accent-blue);
    margin-bottom: 1.5rem;
    margin-top: 3rem;
    font-size: 1.5rem;
}

.integration-category:first-child h3 {
    margin-top: 1.5rem;
}

/* Integration Request Section */
.integration-request {
    text-align: center;
    margin-top: 2rem;
    padding: 1rem;
}

.integration-request p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
}

.btn-small {
    padding: 0.6rem 1.2rem;
    font-size: 0.85rem;
}

/* Features CTA Section */
.features-cta {
    text-align: center;
}

/* Coming Soon Section */
.coming-soon {
    padding: 80px 0;
    text-align: center;
    background: var(--secondary-bg);
}

.coming-soon-content {
    max-width: 800px;
    margin: 0 auto;
}

.coming-soon-icon {
    font-size: 4rem;
    margin-bottom: 2rem;
    display: block;
}

.coming-soon h2 {
    color: var(--accent-blue);
    margin-bottom: 1.5rem;
}

.coming-soon p {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
    line-height: 1.7;
}

.coming-soon-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
}

.feature-preview {
    background: var(--tertiary-bg);
    padding: 2rem 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease;
}

.feature-preview:hover {
    transform: translateY(-5px);
}

.preview-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
}

.feature-preview h4 {
    color: var(--text-primary);
    font-size: 1.1rem;
    margin: 0;
}

.coming-soon-cta {
    background: var(--tertiary-bg);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
}

.coming-soon-cta p {
    font-size: 1rem;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
}

/* Stay Updated Section */
.stay-updated {
    padding: 80px 0;
    text-align: center;
}

.update-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
}

.update-option {
    background: var(--tertiary-bg);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.update-option:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 255, 255, 0.1);
}

.update-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    display: block;
}

.update-option h3 {
    color: var(--accent-blue);
    margin-bottom: 1rem;
    font-size: 1.4rem;
}

.update-option p {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
}

.feature-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
}

.feature-item {
    background: var(--tertiary-bg);
    padding: 1.5rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
}

.feature-item h4 {
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
}

.integration-showcase {
    margin-top: 4rem;
    text-align: center;
}

.integration-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
}

.integration-item {
    background: var(--tertiary-bg);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.3s ease;
    position: relative;
}

.integration-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

/* Integration Status Styles */
.integration-item.available {
    border-color: var(--success-color);
    color: var(--text-primary);
    background: rgba(0, 204, 102, 0.1);
}

.integration-item.available:hover {
    border-color: var(--success-color);
    color: var(--success-color);
    box-shadow: 0 4px 12px rgba(0, 204, 102, 0.2);
}

.integration-item.in-development {
    border-color: var(--warning-color);
    color: var(--text-primary);
    background: rgba(255, 159, 0, 0.1);
}

.integration-item.in-development:hover {
    border-color: var(--warning-color);
    color: var(--warning-color);
    box-shadow: 0 4px 12px rgba(255, 159, 0, 0.2);
}

.integration-item.planning {
    border-color: var(--text-muted);
    color: var(--text-muted);
    background: rgba(136, 136, 136, 0.1);
}

.integration-item.planning:hover {
    border-color: var(--text-secondary);
    color: var(--text-secondary);
    box-shadow: 0 4px 12px rgba(136, 136, 136, 0.2);
}

/* Integration Legend */
.integration-legend {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 3rem;
    padding: 2rem;
    background: var(--tertiary-bg);
    border-radius: 12px;
    border: 1px solid var(--border-color);
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.legend-indicator {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid;
}

.legend-indicator.available {
    background: rgba(0, 204, 102, 0.2);
    border-color: var(--success-color);
}

.legend-indicator.in-development {
    background: rgba(255, 159, 0, 0.2);
    border-color: var(--warning-color);
}

.legend-indicator.planning {
    background: rgba(136, 136, 136, 0.2);
    border-color: var(--text-muted);
}

/* Getting Started Section */
.code-block {
    background: var(--code-bg);
    border-radius: 8px;
    overflow-x: auto;
    margin-top: 1rem;
}

.code-block pre {
    padding: 1.5rem;
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.5;
}

.install-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.install-option {
    background: var(--tertiary-bg);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
}

.install-option h4 {
    color: var(--accent-blue);
    margin-bottom: 1rem;
}

.install-commands {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1rem;
}

.install-commands code {
    background: var(--code-bg);
    padding: 0.8rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-cyan);
}

.next-steps ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
}

.next-steps li {
    background: var(--tertiary-bg);
    border-radius: 8px;
    border: 1px solid var(--border-color);
    transition: all 0.3s ease;
}

.next-steps li:hover {
    border-color: var(--accent-blue);
}

.next-steps a {
    display: block;
    padding: 1.5rem;
    color: var(--text-primary);
    text-decoration: none;
    font-weight: 500;
}

.next-steps a:hover {
    color: var(--accent-blue);
}

/* Roadmap Section */
.roadmap {
    background: var(--secondary-bg);
}

.roadmap-status {
    text-align: center;
    margin-bottom: 3rem;
}

.status-badge {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
}

.status-badge.current {
    background: rgba(255, 159, 0, 0.2);
    color: var(--warning-color);
    border: 1px solid var(--warning-color);
}

.status-badge.alpha {
    background: rgba(255, 255, 0, 0.2);
    color: #ffff00;
    border: 1px solid #ffff00;
}

.status-badge.planning {
    background: rgba(0, 123, 255, 0.2);
    color: #007bff;
    border: 1px solid #007bff;
}

.modules-roadmap {
    display: grid;
    gap: 2rem;
}

.module-roadmap {
    background: var(--tertiary-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
}

.module-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
}

.module-info h3 {
    flex: 1;
    margin: 0;
    color: var(--text-primary);
}

.milestones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.8rem;
    margin-bottom: 1rem;
}

.milestone {
    padding: 0.8rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
}

.milestone.completed {
    background: rgba(0, 204, 102, 0.2);
    color: var(--success-color);
}

.milestone.in-progress {
    background: rgba(255, 159, 0, 0.2);
    color: var(--warning-color);
}

.milestone.upcoming {
    background: rgba(136, 136, 136, 0.2);
    color: var(--text-muted);
}

.expected-release {
    color: var(--accent-blue);
    font-weight: 500;
    font-size: 0.9rem;
}

/* Community Section */
.community-channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
}

.channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
}

.channel-card {
    background: var(--tertiary-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.channel-card .btn {
    margin-top: auto;
}

.channel-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-blue);
    box-shadow: var(--glow-blue);
}

.channel-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
}

.channel-card h3 {
    color: var(--text-primary);
    margin-bottom: 1rem;
}

.channel-card ul {
    list-style: none;
    text-align: left;
    margin: 1.5rem 0;
}

.channel-card li {
    color: var(--text-secondary);
    padding: 0.3rem 0;
    padding-left: 1rem;
    position: relative;
}

.channel-card li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--accent-blue);
}

.contribution-types {
    margin-top: 4rem;
}

.contrib-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
}

.contrib-item {
    background: var(--tertiary-bg);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    text-align: center;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.contrib-item:hover {
    border-color: var(--accent-blue);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 212, 255, 0.1);
}

.contrib-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    display: block;
}

.contrib-item h3 {
    color: var(--accent-blue);
    margin-bottom: 1rem;
    font-size: 1.3rem;
}

.contrib-item p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
    flex-grow: 1;
}

.contrib-details {
    margin-bottom: 1.5rem;
}

.contrib-details ul {
    list-style: none;
    text-align: left;
    padding: 0;
}

.contrib-details li {
    color: var(--text-muted);
    padding: 0.3rem 0;
    padding-left: 1rem;
    position: relative;
    font-size: 0.9rem;
}

.contrib-details li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-blue);
}

.contrib-item .btn {
    margin-top: auto;
}

/* Contributing Guide Section */
.contributing-guide {
    padding: 80px 0;
    background: var(--secondary-bg);
}

.guide-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    margin-top: 3rem;
    align-items: start;
}

.guide-steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.guide-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    background: var(--tertiary-bg);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    transition: all 0.3s ease;
}

.guide-step:hover {
    border-color: var(--accent-blue);
    transform: translateX(5px);
    box-shadow: 0 8px 20px rgba(0, 212, 255, 0.1);
}

.step-number {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-cyan));
    color: var(--primary-bg);
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.2rem;
    flex-shrink: 0;
    box-shadow: var(--glow-blue);
}

.step-content h3 {
    color: var(--accent-blue);
    margin-bottom: 0.8rem;
    font-size: 1.3rem;
}

.step-content p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
}

.contribution-resources {
    background: var(--tertiary-bg);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    height: fit-content;
    position: sticky;
    top: 2rem;
}

.contribution-resources h3 {
    color: var(--accent-blue);
    margin-bottom: 2rem;
    text-align: center;
    font-size: 1.4rem;
}

.resource-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.resource-item {
    background: var(--secondary-bg);
    padding: 1.5rem;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    transition: all 0.3s ease;
}

.resource-item:hover {
    border-color: var(--accent-blue);
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(0, 212, 255, 0.1);
}

.resource-item h4 {
    color: var(--text-primary);
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.resource-item p {
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
}

.resource-item a {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: color 0.3s ease;
}

.resource-item a:hover {
    color: var(--accent-cyan);
    text-decoration: underline;
}

/* FAQ Table of Contents */
.faq-toc {
    background: var(--secondary-bg);
    padding: 60px 0;
    border-bottom: 1px solid var(--border-color);
}

.faq-toc h2 {
    text-align: center;
    color: var(--text-primary);
    margin-bottom: 3rem;
    font-size: 2rem;
}

.faq-nav {
    display: flex;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    justify-content: center;
    flex-wrap: wrap;
}

.faq-nav-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--tertiary-bg);
    border: 2px solid var(--border-color);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.faq-nav-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(76, 175, 80, 0.1), transparent);
    transition: left 0.5s ease;
}

.faq-nav-item:hover::before {
    left: 100%;
}

.faq-nav-item:hover {
    border-color: var(--accent-blue);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(76, 175, 80, 0.15);
}

.faq-nav-item.active {
    border-color: var(--accent-blue);
    background: linear-gradient(135deg, var(--tertiary-bg), rgba(76, 175, 80, 0.05));
    box-shadow: 0 4px 15px rgba(76, 175, 80, 0.1);
}

.nav-icon {
    font-size: 2rem;
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(76, 175, 80, 0.1);
    border-radius: 50%;
    transition: all 0.3s ease;
}

.faq-nav-item:hover .nav-icon {
    background: rgba(76, 175, 80, 0.2);
    transform: scale(1.1);
}

.faq-nav-item.active .nav-icon {
    background: rgba(76, 175, 80, 0.2);
}

.nav-content h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent-blue);
}

.nav-content p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
}

/* Still Have Questions Section */
.still-questions {
    padding: 80px 0;
    text-align: center;
    background: var(--secondary-bg);
}

.contact-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
}

.contact-option {
    background: var(--tertiary-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
}

.contact-option:hover {
    transform: translateY(-5px);
    border-color: var(--accent-blue);
    box-shadow: 0 8px 25px rgba(0, 212, 255, 0.15);
}

.contact-icon {
    font-size: 3rem;
    margin-bottom: 1.5rem;
    display: block;
}

.contact-option h3 {
    color: var(--accent-blue);
    margin-bottom: 1rem;
    font-size: 1.4rem;
}

.contact-option p {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
    flex-grow: 1;
}

.contact-option .btn {
    margin-top: auto;
}

/* Back to Top Button */
.back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    background: var(--accent-blue);
    color: white;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 15px rgba(76, 175, 80, 0.3);
    transition: all 0.3s ease;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    z-index: 1000;
}

.back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.back-to-top:hover {
    background: #45a049;
    transform: translateY(-3px) scale(1.1);
    box-shadow: 0 6px 20px rgba(76, 175, 80, 0.4);
}

.back-to-top:active {
    transform: translateY(-1px) scale(1.05);
}

.back-to-top svg {
    transition: transform 0.2s ease;
}

.back-to-top:hover svg {
    transform: translateY(-2px);
}

/* FAQ Section */
.faq {
    background: var(--secondary-bg);
}

.faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
}

.faq-item {
    background: var(--tertiary-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s ease;
}

.faq-item:hover {
    border-color: var(--accent-blue);
    transform: translateY(-3px);
}

.faq-item h3 {
    color: var(--accent-blue);
    margin-bottom: 1rem;
    font-size: 1.2rem;
}

.faq-item p {
    line-height: 1.6;
}

/* Footer */
footer {
    background: var(--primary-bg);
    border-top: 1px solid var(--border-color);
    padding: 3rem 0 1rem;
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 2rem;
}

.footer-brand h3 {
    color: var(--accent-blue);
    margin-bottom: 1rem;
}

.footer-brand .tagline {
    color: var(--text-muted);
    font-style: italic;
    margin-top: 1rem;
}

.link-group h4 {
    color: var(--text-primary);
    margin-bottom: 1rem;
    font-size: 1.1rem;
}

.link-group ul {
    list-style: none;
}

.link-group ul li {
    margin-bottom: 0.5rem;
}

.link-group ul li a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.3s ease;
}

.link-group ul li a:hover {
    color: var(--accent-blue);
}

.footer-bottom {
    border-top: 1px solid var(--border-color);
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.footer-badges {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.badge {
    background: rgba(0, 212, 255, 0.1);
    border: 1px solid rgba(0, 212, 255, 0.3);
    color: var(--accent-blue);
    padding: 0.3rem 0.8rem;
    border-radius: 15px;
    font-size: 0.8rem;
    font-weight: 500;
}

/* Responsive Design */
@media (max-width: 768px) {
    .nav-menu {
        display: none;
        position: fixed;
        top: 82px;
        left: 0;
        right: 0;
        background: rgba(10, 10, 10, 0.98);
        backdrop-filter: blur(10px);
        flex-direction: column;
        padding: 2rem;
        border-top: 1px solid var(--border-color);
        max-height: calc(100vh - 82px);
        overflow-y: auto;
        z-index: 999;
    }
    
    .nav-menu.active {
        display: flex;
    }
    
    .nav-menu li {
        margin: 0.5rem 0;
    }
    
    .nav-menu a {
        font-size: 1.1rem;
        padding: 0.5rem 0;
        display: block;
        text-align: center;
    }
    
    .nav-toggle {
        display: block;
        font-size: 1.2rem;
        padding: 0.5rem;
    }
    
    .hero-content h1 {
        font-size: 2.5rem;
    }
    
    .hero-subtitle {
        font-size: 1.2rem;
    }
    
    .page-hero {
        padding: 120px 0 60px; /* Reduced padding for mobile */
    }
    
    .page-hero h1 {
        font-size: 2.5rem;
    }
    
    .page-hero .hero-subtitle {
        font-size: 1.1rem;
    }
    
    .hero-description {
        font-size: 1.1rem;
    }
    
    .hero-actions {
        flex-direction: column;
        align-items: center;
    }
    
    .about-content {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    
    .about-stats {
        grid-template-columns: repeat(2, 1fr);
    }
    
    .footer-content {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }
    
    .footer-bottom {
        flex-direction: column;
        text-align: center;
    }
    
    .faq-grid {
        grid-template-columns: 1fr;
    }
    
    .faq-nav {
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }
    
    .faq-nav-item {
        padding: 1rem;
        gap: 0.75rem;
    }
    
    .nav-icon {
        width: 40px;
        height: 40px;
        font-size: 1.5rem;
    }
    
    .nav-content h3 {
        font-size: 1rem;
    }
    
    .nav-content p {
        font-size: 0.8rem;
    }
    
    .faq-toc h2 {
        font-size: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .back-to-top {
        bottom: 1rem;
        right: 1rem;
        width: 45px;
        height: 45px;
    }
    
    .back-to-top svg {
        width: 18px;
        height: 18px;
    }
    
    .community-channels {
        grid-template-columns: 1fr;
    }
    
    .channels-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    
    .problem-content {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .pain-points {
        grid-template-columns: 1fr;
    }

    .solution-principles {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .mission-content {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .mission-stats {
        flex-direction: row;
        justify-content: space-around;
    }

    .community-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .cta-buttons {
        flex-direction: column;
        align-items: center;
    }

    .cta-buttons .btn {
        width: 200px;
    }

    .cta-grid {
        grid-template-columns: 1fr;
    }
    
    .contrib-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
    }
    
    .guide-content {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    
    .guide-step {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
    }
    
    .contribution-resources {
        position: static;
    }
    
    .founders-grid {
        grid-template-columns: 1fr;
    }
    
    .update-options {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    
    .contact-options {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
}

@media (max-width: 480px) {
    :root {
        --container-padding: 0 1rem;
        --section-padding: 3rem 0;
    }
    
    .hero {
        padding: 6rem 0 3rem;
        min-height: 80vh;
    }
    
    .hero-content h1 {
        font-size: 2rem;
    }
    
    .page-hero h1 {
        font-size: 2rem;
    }
    
    .page-hero {
        padding: 100px 0 50px;
    }
    
    .hero-features {
        flex-direction: column;
        align-items: center;
    }
    
    .modules-grid,
    .problem-grid,
    .install-grid,
    .founders-grid {
        grid-template-columns: 1fr;
    }
    
    h2 {
        font-size: 2rem;
    }
    
    .mission blockquote {
        font-size: 1.2rem;
        padding: 1.5rem;
    }
}